# RIXZA X-Ray — environment configuration.
# Every key below is OPTIONAL. With none set, the engine runs fully on
# deterministic checks + heuristic performance estimation at zero cost.
# Copy this file to ".env" and fill in the keys you have.

# --- Server ---
PORT=8787
# Comma-separated list of origins allowed to call the API. "*" allows any.
CORS_ORIGIN=*

# --- Google PageSpeed Insights (Performance dimension + Core Web Vitals) ---
# https://developers.google.com/speed/docs/insights/v5/get-started
# Without this key the engine estimates performance from page weight + fetch timing.
PAGESPEED_API_KEY=

# --- Google Gemini (business interpretation + screenshot/vision analysis) ---
# Without this key the engine writes deterministic explanations and skips vision.
# gemini-2.5-flash is multimodal and fast (thinking is disabled for low latency).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Screenshot provider for the vision step ---
# 'pagespeed' capture is always reused for free when a PSI key is set.
# Extra provider when PSI is off:  microlink (keyless) | none
SCREENSHOT_PROVIDER=microlink

# --- Supabase (lead capture / CRM) ---
# Without these, leads are appended to ./data/leads.jsonl on disk.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_LEADS_TABLE=xray_leads
